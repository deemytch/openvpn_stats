{erl_opts, [debug_info]}.
{deps, []}.

{shell, [
    {config, "config/sys.config"},
    {apps, [ovpn_stats]}
]}.

{relx, [
    {release, {ovpn_stats, "0.1.0"}, [ovpn_stats, ssh, erts]},
    {mode, prod},
    {include_erts, true},
    {extended_start_script, true},
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}
]}.

{profiles, [{prod, [{relx, [{mode, prod}]}]}]}.
