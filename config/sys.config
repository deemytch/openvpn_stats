[{ovpn_stats, [
	{reader, #{
		socket_path => "/run/openvpn-server/THE SOCKET FILE PATH.socket",
		password 		=> <<"PASSWORD HERE FOR MANAGEMENT SOCKET\n">>
		% \n here is mandatory
	}},
	{publisher, #{
		port => SSH PORT,
		host => "SSH HOST",
		opts => [
			{silently_accept_hosts, true},
	    {user_interaction, false},
	    {user, "SSH USER"},
	    {connect_timeout, 500},
	    {auth_methods, "publickey"}
		],
		widget_socket => <<"/run/user/1000/ovpn-widget.sock">>
	}}
]},
{kernel, [
	{logger_level, debug},
	{logger, [
		{handler, default, logger_std_h,
      #{level => debug,
      	config => #{type => standard_io},
      	formatter => {logger_formatter, #{
      									single_line => true,
      									legacy_header => false
    }}}},
    {handler, file, logger_std_h,
      #{level => debug,
        config => #{file => "log/app.log",
                    max_no_bytes => 10485760,
                    max_no_files => 5,
                    burst_limit_enable => false},
        formatter => {logger_formatter, #{
        									single_line => true,
                        	legacy_header => false,
                        	template => [time," ",level," ",pid," ", {mfa,[mfa,":",line," "],[]},msg,"\n"]
    }}}}
	]}
]}].
